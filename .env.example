# Readiness NMS Configuration
APP_NAME="Readiness NMS"
SECRET_KEY="change_this_to_a_secure_random_key_in_production"
DEBUG=True

# Database: Default SQLite for standalone; or MySQL URL:
# DATABASE_URL="mysql+pymysql://nms:permissions@localhost:3306/readiness"
DATABASE_URL="sqlite:///./readiness.db"

# Background Poller interval (in seconds)
POLL_INTERVAL_SECONDS=60

# Server host & port
HOST=127.0.0.1
PORT=8000
